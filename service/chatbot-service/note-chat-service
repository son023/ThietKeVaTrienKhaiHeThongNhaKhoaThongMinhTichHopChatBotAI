MONGO_DB_NAME=dental_chatbot

# --- AI & MODEL CONFIG ---
GEMINI_API_KEY=
# Lưu ý: Đường dẫn trỏ vào folder chứa file config.json
INTENT_MODEL_PATH=app/models/intent_model
NER_MODEL_PATH=app/models/ner_model_final/checkpoint-1545

# --- SYSTEM ---
USE_GPU=false

# Bước 5: nạp data vào db neo4j

python build_knowledge_base.py

# Bước 6: Chạy Service
python -m app.main